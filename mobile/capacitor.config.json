{
  "appId": "com.musaddique.ateer",
  "appName": "Ateer",
  "webDir": "www",
  "server": {
    "url": "https://musaddique-stockcontrol.vercel.app",
    "androidScheme": "https",
    "errorPath": "offline.html"
  },
  "android": {
    "backgroundColor": "#f4f2ef",
    "adjustMarginsForEdgeToEdge": "auto"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#f4f2ef",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "LIGHT",
      "backgroundColor": "#f4f2ef"
    }
  }
}
